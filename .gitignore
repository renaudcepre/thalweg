/simulation/target

# OS
.DS_Store

# Local (personal) startup config; the versioned reference is hexsim.toml.example
/hexsim.toml

# Claude Code worktrees + scheduled tasks
.claude/worktrees/
.claude/scheduled_tasks.lock
simulation/.claude/

# npm dependencies (three.js served locally by the front)
frontend/node_modules/

# Compiled WASM module (artifact of `just wasm`, regenerated on every build).
# wasm-pack drops its own .gitignore in there, but it disappears as soon as
# we empty the folder, we don't depend on it.
frontend/wasm/

# Playwright capture tool
scripts/shot/node_modules/
scripts/shot/out/

# Callgrind profiling artifacts (transient, regenerated by `just profile`)
scripts/profile/out/

# DEM import (real-terrain validation): Python venv + generated JSON,
# regenerated by dem_to_hexgrid.py
scripts/dem_import/.venv/
scripts/dem_import/out/

# Fire calibration script (scratch, in progress)
scripts/shot/calib.mjs
scripts/shot/stepto.mjs

# Static site produced by just build-web (#138)
dist/

# Local clone of the public `thalweg` mirror, rebuilt by scripts/publish.sh.
.publish/
